<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>ResponsibleAI.AgentControlSpec</PackageId>
    <Version>0.4.0-beta.1</Version>
    <Description>Agent Control Specification: a policy decision runtime plugging into agent-hooks as an interceptor. .NET wrapper over the Rust engine; ships the native library agent_control_spec_ffi for linux-x64, linux-arm64, osx-x64, osx-arm64 and win-x64 under runtimes/.</Description>
    <Authors>Microsoft</Authors>
    <Company>Microsoft</Company>
    <Copyright>© Microsoft Corporation. All rights reserved.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/responsibleai/agent-control-spec</RepositoryUrl>
    <!--
      packages.lock.json next to this file records the resolved package
      graph. CI and the release workflow restore with locked-mode, so a
      dependency change must update the lock file in the same PR
      (run `dotnet restore` with the use-lock-file switch).
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!--
      Where the per-RID native builds are staged before packing. The
      release workflow fills this from its build matrix; a local
      `dotnet pack` finds it empty and produces a managed-only package,
      which is why AcsNativeAssetsRequired exists below.
    -->
    <AcsNativeDir Condition="'$(AcsNativeDir)' == ''">$(MSBuildThisFileDirectory)..\..\native\</AcsNativeDir>
  </PropertyGroup>

  <!--
    The managed assembly is useless on its own: every call reaches the
    engine through agent_control_spec_ffi, so a package without the
    native library throws DllNotFoundException on first use. NuGet
    resolves runtimes/{rid}/native/ per consumer RID, so ship one entry
    per supported platform.
  -->
  <ItemGroup>
    <_AcsNativeAsset Include="$(AcsNativeDir)runtimes\**\*" />
    <None Include="@(_AcsNativeAsset)" Pack="true" PackagePath="runtimes\%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <!--
    Publishing a managed-only package is the failure this guard exists to
    stop: it installs cleanly, satisfies a build, and throws at the first
    call. Set AcsNativeAssetsRequired=true when packing for release.
  -->
  <Target Name="AcsVerifyNativeAssets" BeforeTargets="GenerateNuspec"
          Condition="'$(AcsNativeAssetsRequired)' == 'true'">
    <Error Condition="'@(_AcsNativeAsset)' == ''"
           Text="No native assets staged in $(AcsNativeDir)runtimes. A package without agent_control_spec_ffi throws DllNotFoundException on the first call. Build the FFI for each supported RID and stage it before packing." />
  </Target>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ResponsibleAI.AgentHooks" Version="0.1.0-beta.2" />
  </ItemGroup>

</Project>
