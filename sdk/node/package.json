{
  "name": "@responsibleai/agent-control-spec",
  "version": "0.4.0-alpha.1",
  "description": "Agent Control Specification: a policy decision runtime plugging into agent-hooks as an interceptor. Node wrapper over the Rust engine.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/responsibleai/agent-control-spec.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "binding.js",
    "binding.d.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "napi": {
    "binaryName": "agent-control-spec",
    "packageName": "@responsibleai/agent-control-spec",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build:native": "napi build --release --platform --manifest-path native/Cargo.toml --cwd . --js binding.js --dts binding.d.ts --output-dir .",
    "build:native:debug": "napi build --platform --manifest-path native/Cargo.toml --cwd . --js binding.js --dts binding.d.ts --output-dir .",
    "build": "npm run build:native && tsc",
    "bench": "npm run build && node bench/activation.bench.mjs",
    "test": "npm run build && node --test test/*.mjs"
  },
  "dependencies": {
    "@responsibleai/agent-hooks": "0.1.0-alpha.3"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.4",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}